<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.jobhunter.run</string>
  <key>ProgramArguments</key>
  <array>
    <string>/path/to/job-hunter/.venv/bin/python</string>
    <string>/path/to/job-hunter/run_once.py</string>
  </array>
  <key>StartInterval</key><integer>1800</integer>
  <key>RunAtLoad</key><true/>
  <key>StandardOutPath</key><string>/path/to/job-hunter/logs/launchd-run.out</string>
  <key>StandardErrorPath</key><string>/path/to/job-hunter/logs/launchd-run.err</string>
</dict>
</plist>
