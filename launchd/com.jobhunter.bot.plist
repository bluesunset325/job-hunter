<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.jobhunter.bot</string>
  <key>ProgramArguments</key>
  <array>
    <string>/path/to/job-hunter/.venv/bin/python</string>
    <string>/path/to/job-hunter/bot.py</string>
  </array>
  <key>KeepAlive</key><true/>
  <key>RunAtLoad</key><true/>
  <key>StandardOutPath</key><string>/path/to/job-hunter/logs/launchd-bot.out</string>
  <key>StandardErrorPath</key><string>/path/to/job-hunter/logs/launchd-bot.err</string>
</dict>
</plist>
